# URL base de Trayko-api. Debe estar disponible desde el navegador (prefijo PUBLIC_
# = Astro/Vite la expone al cliente). En producción, apunta a la API pública real.
PUBLIC_API_URL=http://localhost:3001

# URL base de Trayko-worker (recibe leads del sitio, ej. el formulario de conductores,
# y los reenvía por correo vía Resend). En producción, apunta al worker desplegado.
PUBLIC_WORKER_URL=http://localhost:3002
