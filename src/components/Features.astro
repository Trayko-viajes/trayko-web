---
import { MagnifyingGlass, PiggyBank, ShieldCheck } from '@phosphor-icons/react/dist/ssr';
---

<!-- Features Section -->
<section class="py-14 sm:py-20 md:py-24 bg-background px-4 sm:px-6">
    <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
            <!-- Feature 1 -->
            <div class="group p-6 sm:p-8 md:p-10 bg-surface-container-lowest rounded-xl hover:shadow-trayko-xl transition-all duration-500 flex flex-col items-center text-center">
                <div class="w-16 h-16 rounded-full bg-primary-fixed flex items-center justify-center mb-6 text-primary-container">
                    <MagnifyingGlass size={30} />
                </div>
                <h3 class="text-xl font-bold mb-4">Encuentra tu ruta ideal</h3>
                <p class="text-on-surface-variant leading-relaxed">Filtra por origen, destino y horario para conectar con personas que viajan por tu mismo corredor.</p>
            </div>
            <!-- Feature 2 -->
            <div class="group p-6 sm:p-8 md:p-10 bg-surface-container-lowest rounded-xl hover:shadow-trayko-xl transition-all duration-500 flex flex-col items-center text-center">
                <div class="w-16 h-16 rounded-full bg-primary-fixed flex items-center justify-center mb-6 text-primary-container">
                    <PiggyBank size={30} />
                </div>
                <h3 class="text-xl font-bold mb-4">Comparte gastos, no riesgos</h3>
                <p class="text-on-surface-variant leading-relaxed">Aporta una contribucion justa para gasolina y peajes, sin intermediaciones de transporte profesional.</p>
            </div>
            <!-- Feature 3 -->
            <div class="group p-6 sm:p-8 md:p-10 bg-surface-container-lowest rounded-xl hover:shadow-trayko-xl transition-all duration-500 flex flex-col items-center text-center">
                <div class="w-16 h-16 rounded-full bg-primary-fixed flex items-center justify-center mb-6 text-primary-container">
                    <ShieldCheck size={30} weight="fill" />
                </div>
                <h3 class="text-xl font-bold mb-4">Confianza en cada viaje</h3>
                <p class="text-on-surface-variant leading-relaxed">Perfiles verificados, reseñas de la comunidad y soporte humano para viajar con tranquilidad.</p>
            </div>
        </div>
    </div>
</section>
