<!-- Features Section -->
<section class="py-14 sm:py-20 md:py-24 bg-surface px-4 sm:px-6">
    <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
            <!-- Feature 1 -->
            <div class="group p-6 sm:p-8 md:p-10 bg-surface-container-lowest rounded-xl hover:shadow-2xl hover:shadow-primary/5 transition-all duration-500 flex flex-col items-center text-center">
                <div class="w-16 h-16 rounded-full bg-primary-fixed flex items-center justify-center mb-6 text-primary-container">
                    <span class="material-symbols-outlined text-3xl" data-icon="person_search">person_search</span>
                </div>
                <h3 class="text-xl font-bold mb-4">Encuentra Compañeros</h3>
                <p class="text-on-surface-variant leading-relaxed">Conecta al instante con conductores y pasajeros que van a tu mismo destino.</p>
            </div>
            <!-- Feature 2 -->
            <div class="group p-6 sm:p-8 md:p-10 bg-surface-container-lowest rounded-xl hover:shadow-2xl hover:shadow-primary/5 transition-all duration-500 flex flex-col items-center text-center">
                <div class="w-16 h-16 rounded-full bg-primary-fixed flex items-center justify-center mb-6 text-primary-container">
                    <span class="material-symbols-outlined text-3xl" data-icon="savings">savings</span>
                </div>
                <h3 class="text-xl font-bold mb-4">Divide los Gastos</h3>
                <p class="text-on-surface-variant leading-relaxed">Comparte los costos de bencina y peajes. Viaja por una fracción de lo que pagarías solo.</p>
            </div>
            <!-- Feature 3 -->
            <div class="group p-6 sm:p-8 md:p-10 bg-surface-container-lowest rounded-xl hover:shadow-2xl hover:shadow-primary/5 transition-all duration-500 flex flex-col items-center text-center">
                <div class="w-16 h-16 rounded-full bg-primary-fixed flex items-center justify-center mb-6 text-primary-container">
                    <span class="material-symbols-outlined text-3xl" data-icon="verified_user">verified_user</span>
                </div>
                <h3 class="text-xl font-bold mb-4">Viajes Verificados</h3>
                <p class="text-on-surface-variant leading-relaxed">Perfiles verificados, calificaciones y pagos seguros para que viajes con total confianza.</p>
            </div>
        </div>
    </div>
</section>
