---

<!-- Popular Routes Section -->
<section class="py-14 sm:py-20 md:py-24 px-4 sm:px-6 overflow-hidden">
    <div class="max-w-7xl mx-auto mb-8 sm:mb-12 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="min-w-0">
            <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight mb-2">Rutas Más Compartidas</h2>
            <p class="text-on-surface-variant font-medium text-sm sm:text-base">Los trayectos favoritos de nuestra comunidad</p>
        </div>
        <div class="flex gap-3 shrink-0">
            <button type="button" class="min-w-[44px] min-h-[44px] rounded-full bg-surface-container-high flex items-center justify-center text-on-surface hover:bg-primary hover:text-white transition-all" aria-label="Anterior">
                <span class="material-symbols-outlined" data-icon="chevron_left">chevron_left</span>
            </button>
            <button type="button" class="min-w-[44px] min-h-[44px] rounded-full bg-surface-container-high flex items-center justify-center text-on-surface hover:bg-primary hover:text-white transition-all" aria-label="Siguiente">
                <span class="material-symbols-outlined" data-icon="chevron_right">chevron_right</span>
            </button>
        </div>
    </div>
    <div class="flex gap-4 sm:gap-8 overflow-x-auto hide-scrollbar pb-8 sm:pb-12 snap-x snap-mandatory px-1 sm:px-4 justify-start sm:justify-center -mx-1 sm:mx-0">
        <!-- Route Card 1 -->
        <div class="w-[85vw] max-w-[340px] shrink-0 md:w-[450px] md:max-w-none aspect-[4/5] relative rounded-xl overflow-hidden snap-center snap-always group">
            <img alt="Eje Cafetero paisaje" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" data-alt="Hermoso paisaje del Eje Cafetero con montañas verdes y plantaciones de café" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCsiPxG9ATOSjjr_4jdwzVWXQTZoR327qe6uMmNbkGKPHW1BqESpfViir12J-n_t0bboPuTdfELarOdUJIbuL__Gehk4NZh-JyIIAKR9lAXmu_6e3quCv1fPQ4xroM2ZoYyzeoNMbPlK_a_N0V4N7Wr1M_ntkL5m3anhFNl0lNp4pjxZrYX-0Yo7ls42k8bHWRzxO62PnQ6fOigMA1cfha5igifSvDewn43y3FVryoigzts0p1E7E30bW3qW3tI5N7k8qIqTgf-dGQ"/>
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4 sm:bottom-8 sm:left-8 sm:right-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                <div class="min-w-0">
                    <span class="bg-secondary text-on-secondary-container px-3 py-1 rounded-full text-xs font-bold mb-2 sm:mb-3 inline-block">Ruta Cafetera</span>
                    <h3 class="text-xl sm:text-3xl font-extrabold text-white leading-tight">Bogotá → Eje Cafetero</h3>
                </div>
                <div class="bg-secondary text-on-secondary-container px-4 py-2 rounded-2xl text-center">
                    <p class="text-[10px] font-bold uppercase tracking-wider">Desde</p>
                    <p class="text-xl font-extrabold">$35.000</p>
                </div>
            </div>
        </div>
        <!-- Route Card 2 -->
        <div class="w-[85vw] max-w-[340px] shrink-0 md:w-[450px] md:max-w-none aspect-[4/5] relative rounded-xl overflow-hidden snap-center snap-always group">
            <img alt="Cartagena vista costera" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" data-alt="Vista panorámica de Cartagena con su centro histórico y el mar Caribe" src="https://lh3.googleusercontent.com/aida-public/AB6AXuA0oqAdxm9-JENsdpydqbmSB-RFpL_fSLGdPF0Lng-soEiCKKWtKeeDyrNOp6iV2hMuruQRlzcnfKXgJogIpJb__T1tngIAkRPmh8o0fL-3A6oqg5HJs8Et4chBpX_zU8jvf--vyg3MxOh_fTpM_ubyNIEB3Yt6HqLXrMV8xLyQ8tei4paoNERZ2aAogjZ6DdJhwPrdrm-Y-5UWemZMpfkiicKGMN1w2UE_dmSPnBnFWyz0BIYHGN-GTuikaVgL_WQd7cYZWsw4rr8"/>
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4 sm:bottom-8 sm:left-8 sm:right-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                <div class="min-w-0">
                    <span class="bg-secondary text-on-secondary-container px-3 py-1 rounded-full text-xs font-bold mb-2 sm:mb-3 inline-block">Ruta Costa</span>
                    <h3 class="text-xl sm:text-3xl font-extrabold text-white leading-tight">Medellín → Cartagena</h3>
                </div>
                <div class="bg-secondary text-on-secondary-container px-4 py-2 rounded-2xl text-center">
                    <p class="text-[10px] font-bold uppercase tracking-wider">Desde</p>
                    <p class="text-xl font-extrabold">$45.000</p>
                </div>
            </div>
        </div>
        <!-- Route Card 3 -->
        <div class="w-[85vw] max-w-[340px] shrink-0 md:w-[450px] md:max-w-none aspect-[4/5] relative rounded-xl overflow-hidden snap-center snap-always group">
            <img alt="Villa de Leyva plaza" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" data-alt="Plaza principal de Villa de Leyva con arquitectura colonial y cielo despejado" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDL8qttS1eNNr4NC898t96_FEl3r3X1vgSx-QJrfQh3N-ygqENublwgdTDZP_tsVWsP1_asrFqqWoVaDwV7tRYag7t13botbhk-7Oxxq7H2BiauxqEtH4u3Sya7kbHlicnDezGZ-mRNbzjXBBL8Q5XhHdngfmFZ95Bdj0_C230rb68fpFLrDDsfymmqom_B1hSrZyMjlI5UreXdCKjjUaCjgSuj4yNPMGXWRrs8BKZpAUadYzC6DjvKoP7nJBgPBYBGB0uc1EIWewM"/>
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4 sm:bottom-8 sm:left-8 sm:right-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                <div class="min-w-0">
                    <span class="bg-secondary text-on-secondary-container px-3 py-1 rounded-full text-xs font-bold mb-2 sm:mb-3 inline-block">Ruta Centro</span>
                    <h3 class="text-xl sm:text-3xl font-extrabold text-white leading-tight">Bogotá → Villa de Leyva</h3>
                </div>
                <div class="bg-secondary text-on-secondary-container px-4 py-2 rounded-2xl text-center">
                    <p class="text-[10px] font-bold uppercase tracking-wider">Desde</p>
                    <p class="text-xl font-extrabold">$25.000</p>
                </div>
            </div>
        </div>
    </div>
</section>
