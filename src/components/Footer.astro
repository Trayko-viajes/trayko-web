---
import { Envelope, Phone } from '@phosphor-icons/react/dist/ssr';
---

<footer
    class="bg-secondary text-white pt-12 sm:pt-16 md:pt-20 px-4 sm:px-6 pb-[calc(2rem+env(safe-area-inset-bottom,0px))] sm:pb-[calc(2.5rem+env(safe-area-inset-bottom,0px))]"
>
    <div class="max-w-7xl mx-auto">
        <div
            class="grid grid-cols-1 md:grid-cols-4 gap-10 md:gap-12 mb-12 md:mb-16"
        >
            <div class="col-span-1 md:col-span-1">
                <img
                    src="/logo-blanco.webp"
                    alt="Trayko"
                    class="w-28 sm:w-32 md:w-40 lg:w-48 h-auto mb-6 transition-transform hover:scale-105"
                    width="240"
                    height="68"
                    loading="lazy"
                />
                <p
                    class="text-white/60 text-sm leading-relaxed max-w-xs"
                >
                    La comunidad de viajes compartidos más grande de Colombia.
                    Conecta, comparte y viaja mejor.
                </p>
            </div>
            <div>
                <h4 class="font-bold mb-6">Explorar</h4>
                <ul class="space-y-4 text-sm text-white/60">
                    <li>
                        <a class="hover:text-primary-container transition-colors" href="/conductores"
                            >Publicar un Viaje</a>
                    </li>
                    <li>
                        <a class="hover:text-primary-container transition-colors" href="#rutas-colombia"
                            >Rutas en Colombia</a>
                    </li>
                    <li>
                        <a class="hover:text-primary-container transition-colors" href="#descargar-app"
                            >Descargar app</a>
                    </li>
                    <li>
                        <a class="hover:text-primary-container transition-colors" href="/preguntas-frecuentes"
                            >Preguntas frecuentes</a>
                    </li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold mb-6">Compañía</h4>
                <ul class="space-y-4 text-sm text-white/60">
                    <li>
                        <a class="hover:text-primary-container transition-colors" href="/#como-funciona"
                            >Sobre nosotros</a>
                    </li>
                    <li>
                        <a class="hover:text-primary-container transition-colors" href="/privacidad"
                            >Privacidad</a>
                    </li>
                    <li>
                        <a class="hover:text-primary-container transition-colors" href="/terminos"
                            >Términos</a>
                    </li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold mb-6">Contacto</h4>
                <ul class="space-y-4 text-sm text-white/60">
                    <li class="flex items-center gap-2">
                        <Envelope size={18} className="text-primary-container shrink-0" />
                        contacto@trayko.co
                    </li>
                    <li class="flex items-center gap-2">
                        <Phone size={18} weight="fill" className="text-primary-container shrink-0" />
                        +57 317 823 4567
                    </li>
                </ul>
            </div>
        </div>
        <div
            class="flex flex-col md:flex-row items-center justify-between pt-10 border-t border-white/10 gap-4"
        >
            <p class="text-xs text-white/40 font-medium">
                © 2024 Trayko. Todos los derechos reservados.
            </p>
        </div>
    </div>
</footer>
