---
import macOsIconUrl from '../assets/icons8-mac-os.svg?url';
import googlePlayIconUrl from '../assets/icons8-google-play.svg?url';
---

<section class="hero-section relative overflow-hidden bg-surface min-h-[72vh] lg:min-h-[76vh] flex flex-col justify-center">
    <div
        class="pointer-events-none absolute inset-0 opacity-45"
        aria-hidden="true"
        style="background-image: radial-gradient(ellipse 80% 50% at 90% 20%, rgba(232, 83, 10, 0.05), transparent), radial-gradient(ellipse 60% 40% at 10% 80%, rgba(34, 34, 34, 0.02), transparent);"
    ></div>
    <div class="pointer-events-none absolute inset-0 opacity-[0.14] hero-dot-pattern" aria-hidden="true"></div>

    <div class="relative z-10 max-w-7xl mx-auto w-full px-4 sm:px-6 pt-28 pb-14 sm:pt-32 sm:pb-16 md:pt-40 md:pb-20 lg:pt-44 lg:pb-20">
        <div class="flex flex-col gap-10 sm:gap-12 lg:gap-14">
            <div class="flex flex-col lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(22rem,27rem)] lg:gap-x-14 xl:gap-x-20 lg:items-center">
                <div class="hero-fade-up max-w-xl lg:max-w-2xl">
                    <h1 class="text-[2.35rem] sm:text-5xl md:text-6xl lg:text-[3.5rem] font-extrabold tracking-tight text-on-surface leading-[1.02] mb-5">
                        <span class="block">¿Viajas solo?</span>
                        <span class="block"><span class="text-primary">Comparte</span> tu ruta.</span>
                        <span class="block">Ahorra viajando.</span>
                    </h1>
                    <p class="text-base sm:text-lg text-on-surface-variant font-normal leading-relaxed max-w-lg">
                        Únete a nuestra comunidad de viajes compartidos. Reduce costos, conoce gente nueva y disminuye tu huella de carbono mientras viajas por la región.
                    </p>
                </div>

                <div class="hero-card-float relative mt-10 lg:mt-0 w-full max-w-md mx-auto lg:mx-0 lg:max-w-none lg:w-full shrink-0 hero-fade-right">
                    <div class="hero-card-glow pointer-events-none absolute -inset-6 sm:-inset-8 rounded-[2.5rem] blur-2xl" aria-hidden="true"></div>
                    <div class="hero-trip-card relative bg-white rounded-[1.75rem] border border-outline-variant/10 p-6 sm:p-7">
                    <!-- Conductor + precio -->
                    <div class="flex items-start justify-between gap-6 pb-6">
                        <div class="flex items-center gap-3.5 min-w-0">
                            <div class="relative shrink-0">
                                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[#d4e4f7] to-[#9bb8d9] flex items-center justify-center text-[#1a3a5c] font-bold text-sm">
                                    CM
                                </div>
                                <span class="absolute -bottom-0.5 -right-0.5 w-5 h-5 rounded-full bg-[#3b82f6] border-2 border-white flex items-center justify-center" title="Conductor verificado">
                                    <svg class="w-2.5 h-2.5 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>
                                </span>
                            </div>
                            <div class="min-w-0">
                                <p class="text-base font-bold text-on-surface leading-tight">Carlos M.</p>
                                <p class="flex items-center gap-1 text-sm text-on-surface-variant mt-0.5">
                                    <svg class="w-3.5 h-3.5 text-amber-400 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                                    4.9
                                </p>
                            </div>
                        </div>
                        <p class="text-[1.65rem] sm:text-2xl font-extrabold text-on-surface tracking-tight shrink-0">$28.000</p>
                    </div>

                    <!-- Timeline ruta -->
                    <div class="relative pb-6 pl-5">
                        <span class="absolute left-[5px] top-2 bottom-8 w-px bg-outline-variant/45" aria-hidden="true"></span>

                        <div class="relative flex gap-3 pb-4">
                            <span class="absolute left-0 top-1.5 w-3 h-3 rounded-full border-[2.5px] border-[#5eb8b0] bg-white shrink-0 z-[1]"></span>
                            <div class="flex-1 min-w-0 pl-5">
                                <div class="flex items-baseline justify-between gap-2">
                                    <span class="text-lg font-bold text-on-surface">07:30</span>
                                    <span class="text-[10px] font-semibold tracking-widest text-on-surface-variant/80 uppercase">Salida</span>
                                </div>
                                <p class="text-sm text-on-surface-variant mt-0.5 leading-snug">Barranquilla, Centro</p>
                            </div>
                        </div>

                        <div class="relative flex items-center gap-1.5 py-1 pl-5 text-xs text-on-surface-variant">
                            <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path stroke-linecap="round" d="M12 6v6l4 2"/></svg>
                            2h 30m
                        </div>

                        <div class="relative flex gap-3 pt-2">
                            <span class="absolute left-0 top-1.5 w-3 h-3 rounded-full border-[2.5px] border-[#1e3a5f] bg-white shrink-0 z-[1]"></span>
                            <div class="flex-1 min-w-0 pl-5">
                                <div class="flex items-baseline justify-between gap-2">
                                    <span class="text-lg font-bold text-on-surface">10:00</span>
                                    <span class="text-[10px] font-semibold tracking-widest text-on-surface-variant/80 uppercase">Llegada</span>
                                </div>
                                <p class="text-sm text-on-surface-variant mt-0.5 leading-snug">Cartagena, Centro</p>
                            </div>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="flex items-center justify-between gap-3 pt-4 border-t border-outline-variant/20">
                        <span class="inline-flex items-center gap-1.5 text-xs font-medium text-on-surface-variant bg-surface-container-low rounded-full px-3 py-1.5">
                            <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 17h8M8 11h8M6 7h12l-1-4H7L6 7zm-1 10a2 2 0 002 2h10a2 2 0 002-2V9H5v8z"/></svg>
                            Sedán compacto
                        </span>
                        <span class="inline-flex items-center gap-1.5 text-xs font-bold text-tertiary bg-tertiary-fixed rounded-full px-3 py-1.5">
                            <svg class="w-3.5 h-3.5 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>
                            3 lugares
                        </span>
                    </div>
                </div>
                </div>
            </div>

            <div class="hero-search-row w-full min-w-0 hero-fade-up-delay">
                <form id="hero-search-form" class="w-full">
                    <div class="hero-search-module bg-surface-container-lowest rounded-2xl border border-surface-container-low/80 px-4 py-3.5 sm:px-5 sm:py-4 w-full">
                        <div class="hero-search-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1.15fr)_minmax(8.5rem,0.85fr)_auto] gap-3 lg:gap-4 items-stretch lg:items-center w-full">
                            <label class="hero-search-field hero-search-field--route flex items-center gap-2.5 min-w-0">
                                <svg class="w-4 h-4 shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path stroke-linecap="round" d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>
                                <input type="text" name="origin" placeholder="¿De dónde sales?" class="hero-search-input w-full min-w-0 bg-transparent text-sm font-semibold text-on-surface placeholder:font-medium placeholder:text-outline" autocomplete="off" />
                            </label>
                            <label class="hero-search-field hero-search-field--route flex items-center gap-2.5 min-w-0">
                                <svg class="w-4 h-4 shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 11c1.66 0 3-1.34 3-3S13.66 5 12 5 9 6.34 9 8s1.34 3 3 3z"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4.5 8-11a8 8 0 10-16 0c0 6.5 8 11 8 11z"/></svg>
                                <input type="text" name="destination" placeholder="¿A dónde vas?" class="hero-search-input w-full min-w-0 bg-transparent text-sm font-semibold text-on-surface placeholder:font-medium placeholder:text-outline" autocomplete="off" />
                            </label>
                            <label class="hero-search-field hero-search-field--date flex items-center gap-2.5 min-w-0 sm:col-span-2 lg:col-span-1">
                                <svg class="w-4 h-4 shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3M4 11h16M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                <input type="text" name="date" id="hero-date" placeholder="¿Cuándo viajas?" class="hero-search-input hero-date-input w-full min-w-0 bg-transparent text-sm font-semibold text-on-surface placeholder:font-medium placeholder:text-outline" />
                            </label>
                            <div class="flex items-center sm:col-span-2 lg:col-span-1 shrink-0">
                                <button type="submit" id="hero-search-btn" class="w-full lg:w-auto inline-flex items-center justify-center gap-1.5 bg-primary-container text-on-primary font-bold text-sm px-6 min-h-[40px] rounded-full hover:bg-primary transition-all duration-300 disabled:opacity-70 whitespace-nowrap shadow-[0_4px_14px_-4px_rgba(232,83,10,0.45)] hover:shadow-[0_6px_20px_-4px_rgba(232,83,10,0.5)]">
                                    <span id="hero-search-label">Buscar</span>
                                    <svg id="hero-search-icon" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z"/></svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div id="hero-results" class="hidden mt-14 sm:mt-16 max-w-3xl">
            <div class="flex items-end justify-between gap-4 mb-5">
                <div>
                    <h2 id="hero-results-title" class="text-lg font-extrabold text-on-surface">Viajes disponibles</h2>
                    <p id="hero-results-sub" class="text-sm text-on-surface-variant mt-1">Selecciona un viaje para continuar en la app</p>
                </div>
                <span id="hero-results-count" class="hidden text-xs font-bold text-primary bg-primary-fixed px-3 py-1 rounded-full"></span>
            </div>
            <div id="hero-results-list" class="flex flex-col gap-3"></div>
        </div>
    </div>
</section>

<div id="hero-modal" class="hidden fixed inset-0 z-[100]" role="dialog" aria-modal="true" aria-labelledby="hero-modal-title">
    <div id="hero-modal-backdrop" class="absolute inset-0 bg-secondary/40 backdrop-blur-sm"></div>
    <div class="absolute left-1/2 top-1/2 w-[calc(100%-2rem)] max-w-md -translate-x-1/2 -translate-y-1/2 bg-white rounded-3xl shadow-2xl border border-outline-variant/20 overflow-hidden">
        <div class="p-6 sm:p-8 relative">
            <button type="button" id="hero-modal-close" class="absolute top-4 right-4 w-10 h-10 rounded-full bg-surface-container-low text-on-surface flex items-center justify-center hover:bg-surface-container transition-colors" aria-label="Cerrar">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
            <p class="text-[10px] font-bold tracking-widest text-primary uppercase mb-2">Reserva en la app</p>
            <h2 id="hero-modal-title" class="text-xl font-extrabold text-on-surface pr-8 leading-snug">Continúa la reserva en la app de Trayko</h2>
            <p id="hero-modal-route" class="text-sm text-on-surface-variant mt-2"></p>
            <p class="text-xs text-on-surface-variant mt-3">Pagos protegidos, conductores verificados y seguimiento en vivo.</p>
            <div class="flex flex-col sm:flex-row gap-3 mt-6">
                <a href="https://apps.apple.com/" target="_blank" rel="noopener noreferrer" class="flex-1 inline-flex items-center justify-center gap-2 bg-secondary text-white font-bold text-sm px-4 py-3.5 min-h-[48px] rounded-xl hover:opacity-90 transition-opacity">
                    <img src={macOsIconUrl} alt="" class="w-6 h-6" width="24" height="24" />
                    App Store
                </a>
                <a href="https://play.google.com/store" target="_blank" rel="noopener noreferrer" class="flex-1 inline-flex items-center justify-center gap-2 bg-primary-container text-on-primary font-bold text-sm px-4 py-3.5 min-h-[48px] rounded-xl hover:bg-primary transition-colors">
                    <img src={googlePlayIconUrl} alt="" class="w-6 h-6" width="24" height="24" />
                    Google Play
                </a>
            </div>
            <div class="mt-6 flex items-center gap-4 p-4 rounded-2xl bg-surface-container-low border border-outline-variant/15">
                <div class="w-20 h-20 shrink-0 rounded-xl bg-white border border-outline-variant/20 flex items-center justify-center p-2" aria-hidden="true">
                    <svg viewBox="0 0 80 80" class="w-full h-full text-on-surface"><rect x="8" y="8" width="18" height="18" fill="currentColor"/><rect x="32" y="8" width="6" height="6" fill="currentColor"/><rect x="44" y="8" width="6" height="6" fill="currentColor"/><rect x="56" y="8" width="6" height="6" fill="currentColor"/><rect x="8" y="32" width="6" height="6" fill="currentColor"/><rect x="32" y="32" width="18" height="6" fill="currentColor"/><rect x="56" y="32" width="6" height="6" fill="currentColor"/><rect x="8" y="44" width="6" height="6" fill="currentColor"/><rect x="32" y="44" width="6" height="6" fill="currentColor"/><rect x="44" y="44" width="6" height="18" fill="currentColor"/><rect x="8" y="56" width="18" height="6" fill="currentColor"/></svg>
                </div>
                <p class="text-xs text-on-surface-variant leading-relaxed">Escanea el código QR con tu celular para abrir Trayko y completar tu reserva en segundos.</p>
            </div>
        </div>
    </div>
</div>

<script>
    import { filterTrips, formatPrice, formatTripDate } from '../scripts/hero-search';

    const form = document.getElementById('hero-search-form') as HTMLFormElement;
    const resultsEl = document.getElementById('hero-results');
    const resultsList = document.getElementById('hero-results-list');
    const resultsTitle = document.getElementById('hero-results-title');
    const resultsSub = document.getElementById('hero-results-sub');
    const resultsCount = document.getElementById('hero-results-count');
    const searchBtn = document.getElementById('hero-search-btn');
    const searchLabel = document.getElementById('hero-search-label');
    const searchIcon = document.getElementById('hero-search-icon');
    const modal = document.getElementById('hero-modal');
    const modalRoute = document.getElementById('hero-modal-route');
    const modalClose = document.getElementById('hero-modal-close');
    const modalBackdrop = document.getElementById('hero-modal-backdrop');
    const dateField = document.getElementById('hero-date') as HTMLInputElement | null;

    function activateDateField() {
        if (!dateField || dateField.type === 'date') return;
        dateField.type = 'date';
        dateField.showPicker?.();
    }

    function deactivateDateFieldIfEmpty() {
        if (!dateField || dateField.value) return;
        dateField.type = 'text';
    }

    dateField?.addEventListener('focus', activateDateField);
    dateField?.addEventListener('blur', deactivateDateFieldIfEmpty);

    function openModal(origin: string, destination: string, time: string) {
        if (!modal || !modalRoute) return;
        modalRoute.textContent = `${origin} → ${destination} · Salida ${time}`;
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeModal() {
        modal?.classList.add('hidden');
        document.body.style.overflow = '';
    }

    modalClose?.addEventListener('click', closeModal);
    modalBackdrop?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal();
    });

    form?.addEventListener('submit', (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const origin = String(data.get('origin') ?? '');
        const destination = String(data.get('destination') ?? '');
        const date = String(data.get('date') ?? '');

        searchBtn?.setAttribute('disabled', 'true');
        if (searchLabel) searchLabel.textContent = '';
        searchIcon?.classList.add('hidden');
        const spinner = document.createElement('span');
        spinner.className = 'w-5 h-5 border-2 border-white/40 border-t-white rounded-full animate-spin';
        searchBtn?.prepend(spinner);

        window.setTimeout(() => {
            const trips = filterTrips(origin, destination, date);
            if (!resultsEl || !resultsList || !resultsTitle || !resultsSub || !resultsCount) return;

            resultsEl.classList.remove('hidden');
            resultsList.innerHTML = '';

            if (trips.length === 0) {
                resultsTitle.textContent = 'Sin resultados';
                resultsSub.textContent = 'Prueba otras ciudades o fechas';
                resultsCount.classList.add('hidden');
                resultsList.innerHTML = '<div class="rounded-2xl border border-dashed border-outline-variant/40 bg-white/80 px-6 py-10 text-center text-sm text-on-surface-variant">No encontramos viajes con esos criterios. Ejemplo: Barranquilla → Cartagena.</div>';
            } else {
                resultsTitle.textContent = 'Viajes disponibles';
                resultsSub.textContent = 'Selecciona un viaje para continuar en la app';
                resultsCount.textContent = `${trips.length} ${trips.length === 1 ? 'ruta' : 'rutas'}`;
                resultsCount.classList.remove('hidden');

                trips.forEach((trip) => {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'w-full text-left bg-white rounded-2xl border border-outline-variant/25 p-5 sm:p-6 hover:border-primary/30 hover:shadow-[0_12px_40px_-16px_rgba(232,83,10,0.25)] transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/40';
                    btn.innerHTML = `
                        <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6">
                            <div class="flex-1 min-w-0">
                                <p class="text-lg font-extrabold text-on-surface">${trip.origin} → ${trip.destination}</p>
                                <p class="text-sm text-on-surface-variant mt-1">${formatTripDate(trip.date)} · Salida ${trip.departureTime}</p>
                            </div>
                            <div class="flex items-center gap-4 sm:gap-6">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full bg-primary-fixed text-primary font-bold text-xs flex items-center justify-center">${trip.driverInitials}</div>
                                    <div>
                                        <p class="text-sm font-semibold text-on-surface">${trip.driverName}</p>
                                        <p class="text-xs text-on-surface-variant">★ ${trip.rating.toFixed(1)}</p>
                                    </div>
                                </div>
                                <div class="text-right sm:pl-6 sm:border-l border-outline-variant/25">
                                    <p class="text-xl font-extrabold text-on-surface">${formatPrice(trip.price)}</p>
                                    <p class="text-xs font-semibold text-tertiary mt-0.5">${trip.seats} ${trip.seats === 1 ? 'cupo' : 'cupos'}</p>
                                </div>
                            </div>
                        </div>`;
                    btn.addEventListener('click', () => openModal(trip.origin, trip.destination, trip.departureTime));
                    resultsList.appendChild(btn);
                });
            }

            resultsEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            searchBtn?.removeAttribute('disabled');
            spinner.remove();
            searchIcon?.classList.remove('hidden');
            if (searchLabel) searchLabel.textContent = 'Buscar';
        }, 450);
    });
</script>

<style>
    .hero-search-module {
        box-shadow:
            0 1px 2px rgba(34, 34, 34, 0.04),
            0 8px 28px -12px rgba(34, 34, 34, 0.08);
        transition: box-shadow 0.35s ease;
    }

    .hero-search-module:focus-within {
        box-shadow:
            0 1px 2px rgba(34, 34, 34, 0.04),
            0 12px 36px -10px rgba(232, 83, 10, 0.1);
    }

    .hero-search-field {
        background: #f0eeec;
        border-radius: 9999px;
        padding: 0.5rem 0.875rem;
        min-height: 40px;
        width: 100%;
        transition: background-color 0.2s ease, width 0.2s ease;
    }

    .hero-search-input {
        flex: 1 1 auto;
        min-width: 0;
        width: 100%;
    }

    @media (min-width: 1024px) {
        .hero-search-row .hero-search-field--route,
        .hero-search-row .hero-search-field--date {
            width: 100%;
            flex: unset;
            max-width: none;
        }
    }

    .hero-search-field:focus-within {
        background: #ebe8e5;
    }

    .hero-card-glow {
        background: radial-gradient(
            ellipse 75% 65% at 50% 45%,
            rgba(232, 83, 10, 0.1),
            rgba(232, 83, 10, 0.03) 45%,
            transparent 72%
        );
    }

    .hero-trip-card {
        box-shadow:
            0 2px 8px rgba(34, 34, 34, 0.04),
            0 24px 56px -16px rgba(34, 34, 34, 0.14);
        transition:
            transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
            box-shadow 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .hero-card-float:hover .hero-trip-card {
        transform: translateY(-6px);
        box-shadow:
            0 4px 12px rgba(34, 34, 34, 0.05),
            0 32px 64px -14px rgba(34, 34, 34, 0.16);
    }

    .hero-search-input,
    .hero-date-input {
        border: none !important;
        box-shadow: none !important;
        outline: none;
        --tw-ring-shadow: 0 0 #0000;
    }

    .hero-search-input:focus,
    .hero-date-input:focus {
        border: none !important;
        box-shadow: none !important;
        outline: none;
    }

    .hero-date-input {
        color-scheme: light;
    }

    .hero-date-input[type='date']::-webkit-calendar-picker-indicator {
        opacity: 0.45;
        cursor: pointer;
    }

    .hero-dot-pattern {
        background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23d5d2cf' fill-opacity='0.22'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/svg%3E");
    }

    @keyframes heroFadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
    }
    @keyframes heroFadeRight {
