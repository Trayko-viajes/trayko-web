---
import macOsIconUrl from '../assets/icons8-mac-os.svg?url';
import googlePlayIconUrl from '../assets/icons8-google-play.svg?url';
import { Check, Star, Clock, Car, Crosshair, MapPin, Calendar, MagnifyingGlass, X } from '@phosphor-icons/react/dist/ssr';
import { PLAY_STORE_URL, appStoreUrl } from '../data/site';

const iosUrl = appStoreUrl();
---

<section class="hero-section relative overflow-hidden bg-background min-h-[72vh] lg:min-h-[76vh] flex flex-col justify-center">
    <div
        class="pointer-events-none absolute inset-0 opacity-45"
        aria-hidden="true"
        style="background-image: radial-gradient(ellipse 80% 50% at 90% 20%, rgba(232, 83, 10, 0.05), transparent), radial-gradient(ellipse 60% 40% at 10% 80%, rgba(34, 34, 34, 0.02), transparent);"
    ></div>
    <div class="pointer-events-none absolute inset-0 opacity-[0.14] hero-dot-pattern" aria-hidden="true"></div>

    <div class="relative z-10 max-w-7xl mx-auto w-full px-4 sm:px-6 pt-28 pb-14 sm:pt-32 sm:pb-16 md:pt-40 md:pb-20 lg:pt-44 lg:pb-20">
        <div class="flex flex-col gap-10 sm:gap-12 lg:gap-14">
            <div class="flex flex-col lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(22rem,27rem)] lg:gap-x-14 xl:gap-x-20 lg:items-center">
                <div class="hero-fade-up max-w-xl lg:max-w-2xl">
                    <h1 class="text-[2.35rem] sm:text-5xl md:text-6xl lg:text-[3.5rem] font-extrabold tracking-tight text-on-surface leading-[1.02] mb-5">
                        <span class="block">Viajes compartidos</span>
                        <span class="block">entre ciudades de</span>
                        <span class="block"><span class="text-primary">Colombia.</span></span>
                    </h1>
                    <p class="text-base sm:text-lg text-on-surface-variant font-normal leading-relaxed max-w-lg">
                        Encuentra cupos para tu próximo viaje o publica los de tu carro. Comparte gastos y coordina el trayecto con otros viajeros desde la app de Trayko.
                    </p>
                </div>

                <div class="hidden lg:block relative mt-10 lg:mt-0 w-full max-w-md mx-auto lg:mx-0 lg:max-w-none lg:w-full shrink-0">
                    <div class="hero-card-glow pointer-events-none absolute -inset-6 sm:-inset-8 rounded-[2.5rem] blur-2xl" aria-hidden="true"></div>
                    <div class="hero-trip-card relative bg-white rounded-[1.75rem] border border-outline-variant/10 p-6 sm:p-7">
                    <!-- Conductor + precio -->
                    <div class="flex items-start justify-between gap-6 pb-6">
                        <div class="flex items-center gap-3.5 min-w-0">
                            <div class="relative shrink-0">
                                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[#d4e4f7] to-[#9bb8d9] flex items-center justify-center text-[#1a3a5c] font-bold text-sm">
                                    CM
                                </div>
                                <span class="absolute -bottom-0.5 -right-0.5 w-5 h-5 rounded-full bg-[#3b82f6] border-2 border-white flex items-center justify-center" title="Conductor verificado">
                                    <Check size={10} weight="bold" className="text-white" />
                                </span>
                            </div>
                            <div class="min-w-0">
                                <p class="text-base font-bold text-on-surface leading-tight">Carlos M.</p>
                                <p class="flex items-center gap-1 text-sm text-on-surface-variant mt-0.5">
                                    <Star size={14} weight="fill" className="text-amber-400 shrink-0" />
                                    4.9
                                </p>
                            </div>
                        </div>
                        <p class="text-[1.65rem] sm:text-2xl font-extrabold text-on-surface tracking-tight shrink-0">$28.000</p>
                    </div>

                    <!-- Timeline ruta -->
                    <div class="relative pb-6 pl-5">
                        <span class="absolute left-[5px] top-2 bottom-8 w-px bg-outline-variant/45" aria-hidden="true"></span>

                        <div class="relative flex gap-3 pb-4">
                            <span class="absolute left-0 top-1.5 w-3 h-3 rounded-full border-[2.5px] border-[#5eb8b0] bg-white shrink-0 z-[1]"></span>
                            <div class="flex-1 min-w-0 pl-5">
                                <div class="flex items-baseline justify-between gap-2">
                                    <span class="text-lg font-bold text-on-surface">07:30</span>
                                    <span class="text-[10px] font-semibold tracking-widest text-on-surface-variant/80 uppercase">Salida</span>
                                </div>
                                <p class="text-sm text-on-surface-variant mt-0.5 leading-snug">Barranquilla, Centro</p>
                            </div>
                        </div>

                        <div class="relative flex items-center gap-1.5 py-1 pl-5 text-xs text-on-surface-variant">
                            <Clock size={14} weight="fill" className="shrink-0" />
                            2h 30m
                        </div>

                        <div class="relative flex gap-3 pt-2">
                            <span class="absolute left-0 top-1.5 w-3 h-3 rounded-full border-[2.5px] border-[#1e3a5f] bg-white shrink-0 z-[1]"></span>
                            <div class="flex-1 min-w-0 pl-5">
                                <div class="flex items-baseline justify-between gap-2">
                                    <span class="text-lg font-bold text-on-surface">10:00</span>
                                    <span class="text-[10px] font-semibold tracking-widest text-on-surface-variant/80 uppercase">Llegada</span>
                                </div>
                                <p class="text-sm text-on-surface-variant mt-0.5 leading-snug">Cartagena, Centro</p>
                            </div>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="flex items-center justify-between gap-3 pt-4 border-t border-outline-variant/20">
                        <span class="inline-flex items-center gap-1.5 text-xs font-medium text-on-surface-variant bg-surface-container-low rounded-full px-3 py-1.5">
                            <Car size={14} className="shrink-0" />
                            Sedán compacto
                        </span>
                        <span class="inline-flex items-center gap-1.5 text-xs font-bold text-tertiary bg-tertiary-fixed rounded-full px-3 py-1.5">
                            <Check size={14} weight="bold" className="shrink-0" />
                            3 lugares
                        </span>
                    </div>
                </div>
                </div>
            </div>

            <div class="hero-search-row w-full min-w-0 hero-fade-up-delay">
                <form id="hero-search-form" class="w-full">
                    <div class="hero-search-module bg-surface-container-lowest rounded-[2.25rem] border border-surface-container-low px-4 py-4 sm:px-5 sm:py-5 w-full">
                        <div class="hero-search-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1.15fr)_minmax(8.5rem,0.85fr)_auto] gap-3 lg:gap-4 items-stretch lg:items-end w-full">
                            <div class="flex flex-col gap-1.5 min-w-0 relative">
                                <span class="hero-search-label">Origen</span>
                                <label class="hero-search-field hero-search-field--route flex items-center gap-3 min-w-0">
                                    <Crosshair size={20} weight="bold" className="shrink-0 text-primary" />
                                    <input type="text" name="origin" id="hero-origin" placeholder="¿De dónde sales?" class="hero-search-input w-full min-w-0 bg-transparent text-sm font-semibold text-on-surface placeholder:font-medium placeholder:text-outline" autocomplete="off" />
                                </label>
                                <ul id="hero-origin-suggestions" class="hero-suggestions hidden absolute left-0 right-0 top-full mt-1.5 z-30 max-h-60 overflow-y-auto rounded-2xl border border-surface-container-low bg-white shadow-trayko-md p-1.5" role="listbox"></ul>
                            </div>
                            <div class="flex flex-col gap-1.5 min-w-0 relative">
                                <span class="hero-search-label">Destino</span>
                                <label class="hero-search-field hero-search-field--route flex items-center gap-3 min-w-0">
                                    <MapPin size={20} weight="fill" className="shrink-0 text-primary" />
                                    <input type="text" name="destination" id="hero-destination" placeholder="¿A dónde vas?" class="hero-search-input w-full min-w-0 bg-transparent text-sm font-semibold text-on-surface placeholder:font-medium placeholder:text-outline" autocomplete="off" />
                                </label>
                                <ul id="hero-destination-suggestions" class="hero-suggestions hidden absolute left-0 right-0 top-full mt-1.5 z-30 max-h-60 overflow-y-auto rounded-2xl border border-surface-container-low bg-white shadow-trayko-md p-1.5" role="listbox"></ul>
                            </div>
                            <div class="flex flex-col gap-1.5 min-w-0 sm:col-span-2 lg:col-span-1">
                                <span class="hero-search-label">Fecha de viaje</span>
                                <label class="hero-search-field hero-search-field--date flex items-center gap-3 min-w-0">
                                    <Calendar size={18} className="shrink-0 text-primary" />
                                    <input type="text" name="date" id="hero-date" placeholder="¿Cuándo viajas?" class="hero-search-input hero-date-input w-full min-w-0 bg-transparent text-sm font-semibold text-on-surface placeholder:font-medium placeholder:text-outline" />
                                </label>
                            </div>
                            <div class="flex items-center sm:col-span-2 lg:col-span-1 shrink-0">
                                <button type="submit" id="hero-search-btn" class="w-full lg:w-auto inline-flex items-center justify-center gap-1.5 bg-primary-container text-on-primary font-bold text-sm px-6 min-h-[44px] rounded-full hover:bg-primary transition-all duration-300 disabled:opacity-70 whitespace-nowrap shadow-[0_4px_14px_-4px_rgba(232,83,10,0.35)] hover:shadow-[0_6px_20px_-4px_rgba(232,83,10,0.4)]">
                                    <span id="hero-search-label">Buscar</span>
                                    <MagnifyingGlass id="hero-search-icon" size={18} weight="bold" className="shrink-0" />
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div id="hero-results" class="hidden mt-14 sm:mt-16 w-full">
            <div class="flex items-end justify-between gap-4 mb-5">
                <div>
                    <h2 id="hero-results-title" class="text-lg font-extrabold text-on-surface">Viajes disponibles</h2>
                    <p id="hero-results-sub" class="text-sm text-on-surface-variant mt-1">Selecciona un viaje para continuar en la app</p>
                </div>
                <span id="hero-results-count" class="hidden text-xs font-bold text-primary bg-primary-fixed px-3 py-1 rounded-full"></span>
            </div>
            <div id="hero-results-list" class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4"></div>
        </div>
    </div>
</section>

<div id="hero-modal" class="hidden fixed inset-0 z-[100]" role="dialog" aria-modal="true" aria-labelledby="hero-modal-title">
    <div id="hero-modal-backdrop" class="absolute inset-0 bg-secondary/40 backdrop-blur-sm"></div>
    <div class="absolute left-1/2 top-1/2 w-[calc(100%-2rem)] max-w-md -translate-x-1/2 -translate-y-1/2 bg-primary-container rounded-3xl shadow-trayko-xl overflow-hidden">
        <div class="absolute inset-0 opacity-20 pointer-events-none" aria-hidden="true">
            <div class="absolute top-0 left-0 w-72 h-72 bg-white rounded-full -translate-x-1/2 -translate-y-1/2 blur-3xl"></div>
            <div class="absolute bottom-0 right-0 w-72 h-72 bg-primary-fixed rounded-full translate-x-1/2 translate-y-1/2 blur-3xl"></div>
        </div>
        <div class="p-6 sm:p-8 relative z-10">
            <button type="button" id="hero-modal-close" class="absolute top-4 right-4 w-10 h-10 rounded-full bg-white/15 text-on-primary flex items-center justify-center hover:bg-white/25 transition-colors" aria-label="Cerrar">
                <X size={20} />
            </button>
            <p class="text-[10px] font-bold tracking-widest text-on-primary/80 uppercase mb-2">Reserva en la app</p>
            <h2 id="hero-modal-title" class="text-xl font-extrabold text-on-primary pr-8 leading-snug">Continúa la reserva en la app de Trayko</h2>
            <p id="hero-modal-route" class="text-sm text-primary-fixed mt-2"></p>
            <p class="text-xs text-primary-fixed mt-3">Pagos protegidos, conductores verificados y seguimiento en vivo.</p>
            <div class="flex flex-col sm:flex-row gap-3 mt-6">
                {iosUrl ? <a href={iosUrl} target="_blank" rel="noopener noreferrer" class="flex-1 inline-flex items-center justify-center gap-2 bg-secondary text-white font-bold text-sm px-4 py-3.5 min-h-[48px] rounded-xl hover:opacity-90 transition-opacity">
                    <img src={macOsIconUrl} alt="" class="w-6 h-6" width="24" height="24" />
                    App Store
                </a> : <span class="flex-1 inline-flex items-center justify-center gap-2 bg-secondary/60 text-white/80 font-bold text-sm px-4 py-3.5 min-h-[48px] rounded-xl">iOS próximamente</span>}
                <a href={PLAY_STORE_URL} target="_blank" rel="noopener noreferrer" class="flex-1 inline-flex items-center justify-center gap-2 bg-secondary text-white font-bold text-sm px-4 py-3.5 min-h-[48px] rounded-xl hover:opacity-90 transition-opacity">
                    <img src={googlePlayIconUrl} alt="" class="w-6 h-6" width="24" height="24" />
                    Google Play
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    import { searchTrips, matchCities, formatPrice, formatTripDate, formatTripTime, type CityOption } from '../scripts/hero-search';

    const form = document.getElementById('hero-search-form') as HTMLFormElement;
    const resultsEl = document.getElementById('hero-results');
    const resultsList = document.getElementById('hero-results-list');
    const resultsTitle = document.getElementById('hero-results-title');
    const resultsSub = document.getElementById('hero-results-sub');
    const resultsCount = document.getElementById('hero-results-count');
    const searchBtn = document.getElementById('hero-search-btn');
    const searchLabel = document.getElementById('hero-search-label');
    const searchIcon = document.getElementById('hero-search-icon');
    const modal = document.getElementById('hero-modal');
    const modalRoute = document.getElementById('hero-modal-route');
    const modalClose = document.getElementById('hero-modal-close');
    const modalBackdrop = document.getElementById('hero-modal-backdrop');
    const dateField = document.getElementById('hero-date') as HTMLInputElement | null;

    function activateDateField() {
        if (!dateField || dateField.type === 'date') return;
        dateField.type = 'date';
        dateField.showPicker?.();
    }

    function deactivateDateFieldIfEmpty() {
        if (!dateField || dateField.value) return;
        dateField.type = 'text';
    }

    dateField?.addEventListener('focus', activateDateField);
    dateField?.addEventListener('blur', deactivateDateFieldIfEmpty);

    const originInput = document.getElementById('hero-origin') as HTMLInputElement | null;
    const destinationInput = document.getElementById('hero-destination') as HTMLInputElement | null;
    const originSuggestions = document.getElementById('hero-origin-suggestions');
    const destinationSuggestions = document.getElementById('hero-destination-suggestions');

    function renderCitySuggestions(container: HTMLElement, input: HTMLInputElement, cities: CityOption[]) {
        container.innerHTML = '';
        if (cities.length === 0) {
            container.classList.add('hidden');
            return;
        }
        cities.forEach((city) => {
            const item = document.createElement('button');
            item.type = 'button';
            item.className = 'w-full text-left px-3 py-2 rounded-xl hover:bg-background transition-colors flex flex-col';
            item.innerHTML = `<span class="text-sm font-semibold text-on-surface">${city.cityName}</span><span class="text-xs text-outline">${city.departmentName}</span>`;
            // mousedown (no click) para que la selección registre antes del blur del input.
            item.addEventListener('mousedown', (e) => {
                e.preventDefault();
                input.value = city.cityName;
                container.classList.add('hidden');
            });
            container.appendChild(item);
        });
        container.classList.remove('hidden');
    }

    function setupCityAutocomplete(input: HTMLInputElement | null, container: HTMLElement | null) {
        if (!input || !container) return;

        async function updateSuggestions() {
            if (!input || !container) return;
            const matches = await matchCities(input.value);
            renderCitySuggestions(container, input, matches);
        }

        input.addEventListener('focus', updateSuggestions);
        input.addEventListener('input', updateSuggestions);
        input.addEventListener('blur', () => {
            window.setTimeout(() => container.classList.add('hidden'), 100);
        });
        input.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') container.classList.add('hidden');
        });
    }

    setupCityAutocomplete(originInput, originSuggestions);
    setupCityAutocomplete(destinationInput, destinationSuggestions);

    function openModal(origin: string, destination: string, time: string) {
        if (!modal || !modalRoute) return;
        modalRoute.textContent = `${origin} → ${destination} · Salida ${time}`;
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeModal() {
        modal?.classList.add('hidden');
        document.body.style.overflow = '';
    }

    modalClose?.addEventListener('click', closeModal);
    modalBackdrop?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal();
    });

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const origin = String(data.get('origin') ?? '').trim();
        const destination = String(data.get('destination') ?? '').trim();
        const date = String(data.get('date') ?? '');

        if (!origin || !destination) return;

        searchBtn?.setAttribute('disabled', 'true');
        if (searchLabel) searchLabel.textContent = '';
        searchIcon?.classList.add('hidden');
        const spinner = document.createElement('span');
        spinner.className = 'w-5 h-5 border-2 border-white/40 border-t-white rounded-full animate-spin';
        searchBtn?.prepend(spinner);

        try {
            const trips = await searchTrips(origin, destination, date);
            if (!resultsEl || !resultsList || !resultsTitle || !resultsSub || !resultsCount) return;

            resultsEl.classList.remove('hidden');
            resultsList.innerHTML = '';

            if (trips.length === 0) {
                resultsTitle.textContent = 'Sin resultados';
                resultsSub.textContent = 'Prueba otras ciudades o fechas';
                resultsCount.classList.add('hidden');
                resultsList.innerHTML = '<div class="sm:col-span-2 rounded-2xl border border-dashed border-outline-variant/40 bg-white/80 px-6 py-10 text-center text-sm text-on-surface-variant">No encontramos viajes con esos criterios. Ejemplo: Barranquilla → Cartagena.</div>';
            } else {
                resultsTitle.textContent = 'Viajes disponibles';
                resultsSub.textContent = 'Selecciona un viaje para continuar en la app';
                resultsCount.textContent = `${trips.length} ${trips.length === 1 ? 'ruta' : 'rutas'}`;
                resultsCount.classList.remove('hidden');

                trips.forEach((trip) => {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'w-full text-left bg-white rounded-2xl border border-outline-variant/25 p-5 sm:p-6 hover:border-primary/30 hover:shadow-[0_12px_40px_-16px_rgba(232,83,10,0.25)] transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/40';
                    const tripTime = formatTripTime(trip.departureTime);
                    const ratingLabel = trip.rating != null ? trip.rating.toFixed(1) : '—';
                    btn.innerHTML = `
                        <div class="flex flex-col lg:flex-row lg:items-center gap-4 lg:gap-6">
                            <div class="flex-1 min-w-0">
                                <p class="text-lg font-extrabold text-on-surface">${trip.origin} → ${trip.destination}</p>
                                <p class="text-sm text-on-surface-variant mt-1">${formatTripDate(trip.departureTime)} · Salida ${tripTime}</p>
                            </div>
                            <div class="flex items-center gap-4 lg:gap-6">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full bg-primary-fixed text-primary font-bold text-xs flex items-center justify-center">${trip.driverInitials}</div>
                                    <div>
                                        <p class="text-sm font-semibold text-on-surface">${trip.driverName}</p>
                                        <p class="text-xs text-on-surface-variant">★ ${ratingLabel}</p>
                                    </div>
                                </div>
                                <div class="text-right lg:pl-6 lg:border-l border-outline-variant/25">
                                    <p class="text-xl font-extrabold text-on-surface">${formatPrice(trip.price)}</p>
                                    <p class="text-xs font-semibold text-tertiary mt-0.5">${trip.seats} ${trip.seats === 1 ? 'cupo' : 'cupos'}</p>
                                </div>
                            </div>
                        </div>`;
                    btn.addEventListener('click', () => openModal(trip.origin, trip.destination, tripTime));
                    resultsList.appendChild(btn);
                });
            }

            resultsEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } catch (error) {
            if (!resultsEl || !resultsList || !resultsTitle || !resultsSub || !resultsCount) return;
            resultsEl.classList.remove('hidden');
            resultsTitle.textContent = 'No pudimos cargar los viajes';
            resultsSub.textContent = 'Intenta de nuevo en un momento.';
            resultsCount.classList.add('hidden');
            resultsList.innerHTML = '<div class="sm:col-span-2 rounded-2xl border border-dashed border-outline-variant/40 bg-white/80 px-6 py-10 text-center text-sm text-on-surface-variant">Ocurrió un problema al buscar viajes. Intenta de nuevo.</div>';
            resultsEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } finally {
            searchBtn?.removeAttribute('disabled');
            spinner.remove();
            searchIcon?.classList.remove('hidden');
            if (searchLabel) searchLabel.textContent = 'Buscar';
        }
    });
</script>

<style>
    .hero-search-module {
        box-shadow:
            0 1px 2px rgba(34, 34, 34, 0.04),
            0 8px 28px -12px rgba(34, 34, 34, 0.08);
        transition: box-shadow 0.35s ease;
    }

    .hero-search-module:focus-within {
        box-shadow:
            0 1px 2px rgba(34, 34, 34, 0.04),
            0 12px 36px -10px rgba(232, 83, 10, 0.1);
    }

    .hero-search-label {
        font-size: 10px;
        font-weight: 700;
        color: #777777;
        letter-spacing: 0.075em;
        text-transform: uppercase;
        margin-left: 0.875rem;
    }

    .hero-search-field {
        background: #fafafa;
        border-radius: 9999px;
        padding: 0.75rem 1.125rem;
        min-height: 48px;
        width: 100%;
        transition: background-color 0.2s ease, width 0.2s ease;
    }

    .hero-search-input {
        flex: 1 1 auto;
        min-width: 0;
        width: 100%;
    }

    @media (min-width: 1024px) {
        .hero-search-row .hero-search-field--route,
        .hero-search-row .hero-search-field--date {
            width: 100%;
            flex: unset;
            max-width: none;
        }
    }

    .hero-search-field:focus-within {
        background: #f0eeec;
    }

    .hero-card-glow {
        background: radial-gradient(
            ellipse 75% 65% at 50% 45%,
            rgba(232, 83, 10, 0.1),
            rgba(232, 83, 10, 0.03) 45%,
            transparent 72%
        );
    }

    .hero-trip-card {
        box-shadow:
            0 2px 8px rgba(34, 34, 34, 0.04),
            0 24px 56px -16px rgba(34, 34, 34, 0.14);
    }

    .hero-search-input,
    .hero-date-input {
        border: none !important;
        box-shadow: none !important;
        outline: none;
        --tw-ring-shadow: 0 0 #0000;
    }

    .hero-search-input:focus,
    .hero-date-input:focus {
        border: none !important;
        box-shadow: none !important;
        outline: none;
    }

    .hero-date-input {
        color-scheme: light;
    }

    .hero-date-input[type='date']::-webkit-calendar-picker-indicator {
        opacity: 0.45;
        cursor: pointer;
