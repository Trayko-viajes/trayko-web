---
---

<div class="px-4 sm:px-6 md:px-10 lg:px-14 pt-[calc(7rem+env(safe-area-inset-top))] sm:pt-28 pb-4 sm:pb-6">
    <section class="hero-card relative overflow-hidden rounded-2xl sm:rounded-3xl mx-auto max-w-7xl aspect-[3/4] sm:aspect-[4/3] md:aspect-[16/8]">
        <!-- Hero Image -->
        <div class="absolute inset-0 z-0">
            <img
                alt="Personas compartiendo un viaje en auto por la carretera"
                class="w-full h-full object-cover"
                src="/hero.webp"
                width="1600"
                height="900"
                fetchpriority="high"
                decoding="async"
            />
        </div>

        <!-- Content -->
        <div class="relative z-10 h-full px-4 sm:px-8 md:px-12 lg:px-16 py-8 sm:py-10 md:py-14 lg:py-16 flex flex-col justify-center">
            <div class="max-w-lg">
                <h1 class="hero-title text-[1.75rem] sm:text-4xl md:text-5xl lg:text-[3.5rem] font-extrabold tracking-tight text-white mb-4 sm:mb-5 leading-[1.12]">
                    Comparte el viaje, divide los costos
                </h1>

                <p class="hero-subtitle text-sm md:text-base text-white/90 font-normal mb-6 sm:mb-8 max-w-sm leading-relaxed">
                    Conecta con personas que van a tu mismo destino. Viaja más barato, conoce gente y reduce tu huella de carbono.
                </p>

                <div class="hero-cta">
                    <button type="button" class="bg-primary-container text-on-primary px-6 min-h-[48px] rounded-full font-semibold text-sm shadow-lg shadow-primary-container/20 inline-flex items-center justify-center gap-2.5 hover:scale-105 transition-all duration-300 w-full sm:w-auto">
                        <span class="material-symbols-outlined text-lg" data-icon="smartphone">smartphone</span>
                        Descargar la aplicación
                    </button>
                </div>
            </div>
        </div>
    </section>
</div>

<style>
    .hero-title {
        text-shadow: 0 2px 16px rgba(0, 0, 0, 0.4), 0 1px 4px rgba(0, 0, 0, 0.3);
    }
    .hero-subtitle {
        text-shadow: 0 1px 8px rgba(0, 0, 0, 0.3);
    }

    @keyframes heroFadeUp {
        from {
            opacity: 0;
            transform: translateY(18px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .hero-title {
        animation: heroFadeUp 0.7s ease-out both;
    }
    .hero-subtitle {
        animation: heroFadeUp 0.7s ease-out 0.1s both;
    }
    .hero-cta {
        animation: heroFadeUp 0.7s ease-out 0.2s both;
    }
</style>
