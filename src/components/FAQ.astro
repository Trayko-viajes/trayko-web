---
import { FAQ_ITEMS } from '../data/faq';
import FaqAccordion from './FaqAccordion.astro';
import { ArrowRight } from '@phosphor-icons/react/dist/ssr';

const featuredFaqs = FAQ_ITEMS.filter((faq) => faq.featured);
---

<section id="preguntas-frecuentes" class="py-14 sm:py-20 md:py-24 bg-background px-4 sm:px-6">
    <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10 sm:mb-16">
            <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight mb-4">Preguntas frecuentes</h2>
            <p class="text-on-surface-variant font-medium">Respuestas rápidas para viajar o conducir con Trayko en Colombia</p>
        </div>

        <FaqAccordion faqs={featuredFaqs} />

        <div class="text-center mt-8 sm:mt-10">
            <a
                href="/preguntas-frecuentes"
                class="inline-flex items-center gap-1.5 font-bold text-primary hover:opacity-80 transition-opacity"
            >
                Ver todas las preguntas
                <ArrowRight size={18} />
            </a>
        </div>
    </div>
</section>
