---
---

<nav
    id="main-nav"
    class="fixed top-0 left-0 right-0 z-50 px-4 sm:px-6 py-3 sm:py-4 transition-all duration-300 pt-[max(0.75rem,env(safe-area-inset-top))]"
>
    <div class="max-w-7xl mx-auto relative">
        <div
            class="nav-inner rounded-full px-4 sm:px-6 md:px-8 py-2.5 sm:py-3 flex items-center justify-between gap-2 sm:gap-4 transition-all duration-300 [&.is-scrolled]:bg-white [&.is-scrolled]:shadow-sm"
        >
            <div class="flex items-center min-w-0">
                <a href="/" class="flex items-center gap-2 shrink-0 min-h-[44px] -my-1">
                    <img
                        src="/logo.webp"
                        alt="Trayko"
                        class="w-[7.5rem] sm:w-32 md:w-52 lg:w-56 xl:w-60 h-auto max-h-12 md:max-h-16 lg:max-h-[4.5rem] xl:max-h-20 object-contain object-left"
                        width="240"
                        height="68"
                    />
                </a>
            </div>
            <div class="flex items-center gap-2 sm:gap-4 shrink-0">
                <a
                    href="/conductores"
                    class="hidden md:inline text-on-surface hover:text-primary transition-colors text-sm font-medium py-2"
                >
                    Conductores
                </a>
                <button
                    type="button"
                    id="nav-menu-btn"
                    class="md:hidden inline-flex items-center justify-center min-w-[44px] min-h-[44px] rounded-full text-on-surface hover:bg-surface-container/80 transition-colors"
                    aria-expanded="false"
                    aria-controls="nav-mobile-panel"
                    aria-label="Abrir menú de navegación"
                >
                    <span class="material-symbols-outlined text-2xl" data-icon="menu" id="nav-menu-icon">menu</span>
                </button>
                <button
                    type="button"
                    class="bg-primary-container text-on-primary px-4 sm:px-6 min-h-[44px] rounded-full font-bold text-sm transition-transform active:scale-95 inline-flex items-center justify-center"
                >
                    Obtener la app
                </button>
            </div>
        </div>

        <div
            id="nav-mobile-panel"
            class="hidden md:hidden absolute left-0 right-0 top-full mt-2 mx-0 sm:mx-1 rounded-2xl bg-white shadow-lg border border-outline-variant/15 py-2 z-40"
            role="dialog"
            aria-label="Navegación"
        >
            <a
                href="/conductores"
                class="flex items-center min-h-[48px] px-4 text-on-surface font-medium hover:bg-surface-container-low active:bg-surface-container transition-colors"
            >
                Conductores
            </a>
        </div>
    </div>
</nav>

<script>
    // @ts-nocheck
    const nav = document.getElementById('main-nav');
    const navInner = nav?.querySelector('.nav-inner');
    const menuBtn = document.getElementById('nav-menu-btn');
    const menuPanel = document.getElementById('nav-mobile-panel');
    const menuIcon = document.getElementById('nav-menu-icon');

    function updateNav() {
        if (!nav || !navInner) return;
        const scrolled = window.scrollY > 50;
        navInner.classList.toggle('is-scrolled', scrolled);
    }

    function setMenuOpen(open) {
        if (!menuPanel || !menuBtn || !menuIcon) return;
        menuPanel.classList.toggle('hidden', !open);
        menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        menuBtn.setAttribute('aria-label', open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
        menuIcon.textContent = open ? 'close' : 'menu';
        document.body.style.overflow = open ? 'hidden' : '';
    }

    updateNav();
    window.addEventListener('scroll', updateNav, { passive: true });

    menuBtn?.addEventListener('click', () => {
        const open = menuPanel?.classList.contains('hidden');
        setMenuOpen(!!open);
    });

    menuPanel?.querySelector('a')?.addEventListener('click', () => setMenuOpen(false));

    document.addEventListener('click', (e) => {
        if (!menuPanel || menuPanel.classList.contains('hidden')) return;
        const t = e.target;
        if (t instanceof Node && (menuBtn?.contains(t) || menuPanel.contains(t))) return;
        setMenuOpen(false);
    });

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setMenuOpen(false);
    });
</script>
