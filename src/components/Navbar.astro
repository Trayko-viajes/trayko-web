---
import { List, X } from '@phosphor-icons/react/dist/ssr';
---

<nav
    id="main-nav"
    class="fixed top-0 left-0 right-0 z-50 px-4 sm:px-6 py-3 sm:py-4 transition-all duration-300 pt-[max(0.75rem,env(safe-area-inset-top))]"
>
    <div class="max-w-7xl mx-auto relative">
        <div
            class="nav-inner relative overflow-visible min-h-[60px] rounded-full px-4 sm:px-6 md:px-8 flex items-center justify-end gap-2 sm:gap-4 transition-all duration-300 [&.is-scrolled]:bg-white [&.is-scrolled]:shadow-trayko-sm"
        >
            <span class="nav-logo-spacer shrink-0" aria-hidden="true"></span>
            <a href="/" class="nav-logo-wrap">
                <img
                    src="/logo.png"
                    alt="Trayko"
                    class="nav-logo block w-auto object-contain object-left hover:scale-105 transition-transform duration-300"
                    width="320"
                    height="90"
                />
            </a>
            <div class="flex items-center gap-2 sm:gap-3 shrink-0">
                <a
                    href="/conductores"
                    class="nav-publish hidden md:inline-flex items-center px-4 sm:px-5 min-h-[44px] rounded-full font-bold text-sm transition-all active:scale-95"
                >
                    Publicar viaje
                </a>
                <a
                    href="#descargar-app"
                    class="nav-cta inline-flex items-center px-3 sm:px-6 min-h-[36px] sm:min-h-[44px] rounded-full font-bold text-xs sm:text-sm transition-all active:scale-95 hover:scale-105 shadow-trayko-md"
                >
                    Descargar app
                </a>
                <button
                    type="button"
                    id="nav-menu-btn"
                    class="nav-link md:hidden inline-flex items-center justify-center min-w-[44px] min-h-[44px] rounded-full transition-colors"
                    aria-expanded="false"
                    aria-controls="nav-mobile-panel"
                    aria-label="Abrir menú de navegación"
                >
                    <List size={24} id="nav-menu-icon-open" />
                    <X size={24} id="nav-menu-icon-close" className="hidden" />
                </button>
            </div>
        </div>

        <div
            id="nav-mobile-panel"
            class="hidden md:hidden absolute left-0 right-0 top-full mt-2 mx-0 sm:mx-1 rounded-2xl bg-white shadow-trayko-md border border-outline-variant/15 py-2 z-40"
            role="dialog"
            aria-label="Navegación"
        >
            <a
                href="/conductores"
                class="flex items-center min-h-[48px] px-4 text-on-surface font-bold hover:bg-surface-container-low active:bg-surface-container transition-colors"
            >
                Publicar viaje
            </a>
        </div>
    </div>
</nav>

<script>
    // @ts-nocheck
    const nav = document.getElementById("main-nav");
    const navInner = nav?.querySelector(".nav-inner");
    const menuBtn = document.getElementById("nav-menu-btn");
    const menuPanel = document.getElementById("nav-mobile-panel");
    const menuIconOpen = document.getElementById("nav-menu-icon-open");
    const menuIconClose = document.getElementById("nav-menu-icon-close");

    function updateNav() {
        if (!nav || !navInner) return;
        const scrolled = window.scrollY > 50;
        navInner.classList.toggle("is-scrolled", scrolled);
        nav.classList.toggle("is-scrolled", scrolled);
    }

    function setMenuOpen(open) {
        if (!menuPanel || !menuBtn || !menuIconOpen || !menuIconClose) return;
        menuPanel.classList.toggle("hidden", !open);
        menuBtn.setAttribute("aria-expanded", open ? "true" : "false");
        menuBtn.setAttribute(
            "aria-label",
            open ? "Cerrar menú de navegación" : "Abrir menú de navegación",
        );
        menuIconOpen.classList.toggle("hidden", open);
        menuIconClose.classList.toggle("hidden", !open);
        document.body.style.overflow = open ? "hidden" : "";
    }

    updateNav();
    window.addEventListener("scroll", updateNav, { passive: true });

    menuBtn?.addEventListener("click", () => {
        const open = menuPanel?.classList.contains("hidden");
        setMenuOpen(!!open);
    });

    menuPanel
        ?.querySelector("a")
        ?.addEventListener("click", () => setMenuOpen(false));

    document.addEventListener("click", (e) => {
        if (!menuPanel || menuPanel.classList.contains("hidden")) return;
        const t = e.target;
        if (
            t instanceof Node &&
            (menuBtn?.contains(t) || menuPanel.contains(t))
        )
            return;
        setMenuOpen(false);
    });

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") setMenuOpen(false);
    });
</script>

<style>
    #main-nav .nav-link {
        color: #222222;
    }
    #main-nav .nav-link:hover {
        color: #c4420a;
    }
    #main-nav .nav-publish {
        color: #222222;
        background: transparent;
    }
    #main-nav .nav-publish:hover {
        color: #c4420a;
    }
    #main-nav .nav-cta {
        color: #ffffff;
        background: #e8530a;
    }
    #main-nav .nav-cta:hover {
        background: #c4420a;
    }

    /* Logo fuera del flujo: la barra no crece con su altura */
    .nav-logo-wrap {
        position: absolute;
        left: 1rem;
        top: 50%;
        z-index: 2;
        transform: translateY(-50%);
        transition: transform 0.35s ease;
    }

    @media (min-width: 640px) {
        .nav-logo-wrap {
            left: 1.5rem;
        }
    }

    @media (min-width: 768px) {
        .nav-logo-wrap {
            left: 2rem;
        }
    }

    .nav-logo {
        height: 7rem;
        width: auto;
        transition: height 0.35s ease;
    }

    .nav-logo-spacer {
        width: 13rem;
        transition: width 0.35s ease;
    }

    @media (min-width: 640px) {
        .nav-logo {
            height: 6.25rem;
        }
        .nav-logo-spacer {
            width: 12rem;
        }
    }

    @media (min-width: 768px) {
        .nav-logo {
            height: 8.5rem;
        }
        .nav-logo-spacer {
            width: 16rem;
        }
    }

    @media (min-width: 1024px) {
        .nav-logo {
            height: 9.5rem;
        }
        .nav-logo-spacer {
            width: 18rem;
        }
    }

    @media (min-width: 1280px) {
        .nav-logo {
            height: 10.5rem;
        }
        .nav-logo-spacer {
            width: 20rem;
        }
    }

    #main-nav.is-scrolled {
        padding-top: max(0.5rem, env(safe-area-inset-top));
        padding-bottom: 0.5rem;
    }

    /* Barra compacta fija; el logo es más alto y sobresale sin empujarla */
    #main-nav.is-scrolled .nav-inner {
        height: 64px;
        min-height: 64px;
        max-height: 64px;
    }

    @media (min-width: 768px) {
        #main-nav.is-scrolled .nav-inner {
            height: 72px;
            min-height: 72px;
            max-height: 72px;
        }
    }

    #main-nav.is-scrolled .nav-logo {
        height: 7rem;
        max-height: none;
    }

    #main-nav.is-scrolled .nav-logo-spacer {
        width: 14.5rem;
    }
</style>
