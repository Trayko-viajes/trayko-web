---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navbar />

  <!-- Hero Conductores -->
  <section id="hero-conductores" class="relative pt-32 pb-20 md:pt-40 md:pb-32 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        alt="Trayko Background"
        class="w-full h-full object-cover opacity-15 grayscale"
        data-alt="Modern car traveling on highway at sunset"
        src="https://lh3.googleusercontent.com/aida-public/AB6AXuANLm7IQZmqMejOeSPGWyyAM9HUF0oF2d3bnYkG4jjxF8laEua86LYk57cBc1KjRKJe-V-mlRljOl7gkibBmv9iZ3eCosLI09IM7Yc4yLl3JmDyaQ6TeyyNyrbE9R_Xn9ETd0S139r2TU0AXcsiK_gNti0QFkFkffZCfgNNkyfHDlp_B45naRmNs65X3Qlzu4SwjJfbDbY5SlRvkaeZSSlFFkMCXwo7v9Tq7APYI01tny6UBfl9qmeyyOM24WSod06sM4EPJwBUCqY"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-surface/50 via-surface to-surface"></div>
    </div>
    <div class="max-w-7xl mx-auto px-8 relative z-10">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="space-y-8">
          <h1
            class="text-5xl md:text-7xl font-bold font-headline tracking-tighter text-on-surface leading-[1.1]"
          >
            Comparte tu viaje con
            <span class="text-gradient">Trayko</span>.
          </h1>
          <p class="text-xl md:text-2xl text-on-surface-variant max-w-xl leading-relaxed">
            Conectamos a conductores particulares con personas que van a tu mismo destino. Recupera tus
            costos de combustible de forma colaborativa.
          </p>
          <div class="flex items-center gap-4 text-secondary font-bold">
            <span class="material-symbols-outlined" data-icon="verified_user">verified_user</span>
            <span>Comunidad de Viajes Compartidos Seguros</span>
          </div>
        </div>

        <!-- Registration Form Card -->
        <div class="glass-card p-8 md:p-10 rounded-xl shadow-2xl border border-white/20">
          <h3 class="text-2xl font-bold mb-6 font-headline">Publica tu próximo viaje</h3>
          <form class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label class="text-sm font-bold text-on-surface-variant px-1">Nombre Completo</label>
                <input
                  class="w-full bg-surface-container border-none rounded-lg p-4 focus:ring-2 focus:ring-primary-container transition-all"
                  placeholder="Ej: Juan Pérez"
                  type="text"
                />
              </div>
              <div class="space-y-1.5">
                <label class="text-sm font-bold text-on-surface-variant px-1">Email</label>
                <input
                  class="w-full bg-surface-container border-none rounded-lg p-4 focus:ring-2 focus:ring-primary-container transition-all"
                  placeholder="juan@ejemplo.com"
                  type="email"
                />
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label class="text-sm font-bold text-on-surface-variant px-1">Teléfono</label>
                <input
                  class="w-full bg-surface-container border-none rounded-lg p-4 focus:ring-2 focus:ring-primary-container transition-all"
                  placeholder="+56 9 1234 5678"
                  type="tel"
                />
              </div>
              <div class="space-y-1.5">
                <label class="text-sm font-bold text-on-surface-variant px-1">Ciudad de Origen</label>
                <select
                  class="w-full bg-surface-container border-none rounded-lg p-4 focus:ring-2 focus:ring-primary-container transition-all"
                >
                  <option>Santiago</option>
                  <option>Valparaíso</option>
                  <option>Concepción</option>
                  <option>Antofagasta</option>
                </select>
              </div>
            </div>
            <button
              class="w-full bg-secondary-fixed text-on-secondary-container py-4 rounded-xl font-bold text-lg hover:opacity-90 transition-all shadow-lg mt-4"
              type="submit"
            >
              Empezar a compartir
            </button>
            <p class="text-xs text-center text-on-surface-variant mt-4">
              Trayko es una plataforma de carpooling para compartir gastos de viaje entre particulares.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Beneficios para conductores -->
  <section id="beneficios" class="py-24 bg-surface-container-low">
    <div class="max-w-7xl mx-auto px-8">
      <div class="text-center mb-20">
        <h2 class="text-4xl md:text-5xl font-bold font-headline tracking-tight mb-4">
          ¿Por qué compartir en Trayko?
        </h2>
        <div class="h-1.5 w-24 bg-secondary-container mx-auto rounded-full"></div>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Card 1 -->
        <div
          class="bg-surface-container-lowest p-10 rounded-xl shadow-sm hover:shadow-xl transition-all duration-500 group"
        >
          <div
            class="w-16 h-16 rounded-2xl secondary-container flex items-center justify-center mb-8 group-hover:scale-110 transition-transform"
          >
            <span
              class="material-symbols-outlined text-on-secondary-container text-4xl"
              data-icon="savings"
            >
              savings
            </span>
          </div>
          <h3 class="text-2xl font-bold mb-4 font-headline">Ahorro inteligente</h3>
          <p class="text-on-surface-variant leading-relaxed">
            Ahorra en tus gastos de viaje dividiendo los costos de combustible y peajes con tus acompañantes de
            ruta.
          </p>
        </div>
        <!-- Card 2 -->
        <div
          class="bg-surface-container-lowest p-10 rounded-xl shadow-sm hover:shadow-xl transition-all duration-500 group translate-y-4"
        >
          <div
            class="w-16 h-16 rounded-2xl bg-primary-fixed flex items-center justify-center mb-8 group-hover:scale-110 transition-transform"
          >
            <span class="material-symbols-outlined text-primary text-4xl" data-icon="eco">eco</span>
          </div>
          <h3 class="text-2xl font-bold mb-4 font-headline">Sostenibilidad</h3>
          <p class="text-on-surface-variant leading-relaxed">
            Reduce la huella de carbono y ayuda a descongestionar las carreteras compartiendo los asientos
            libres de tu vehículo.
          </p>
        </div>
        <!-- Card 3 -->
        <div
          class="bg-surface-container-lowest p-10 rounded-xl shadow-sm hover:shadow-xl transition-all duration-500 group"
        >
          <div
            class="w-16 h-16 rounded-2xl bg-tertiary-fixed flex items-center justify-center mb-8 group-hover:scale-110 transition-transform"
          >
            <span class="material-symbols-outlined text-tertiary text-4xl" data-icon="groups">groups</span>
          </div>
          <h3 class="text-2xl font-bold mb-4 font-headline">Compañía en la ruta</h3>
          <p class="text-on-surface-variant leading-relaxed">
            Haz que tus viajes largos sean más amenos compartiendo con personas que viajan a tu mismo destino.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Cómo funciona -->
  <section id="como-funciona" class="py-24">
    <div class="max-w-7xl mx-auto px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="order-2 lg:order-1 relative">
          <div class="rounded-xl overflow-hidden aspect-video shadow-2xl">
            <img
              alt="Shared Trip"
              class="w-full h-full object-cover"
              data-alt="People talking inside a car during a road trip"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuC1UOZthd1YOjYAiDTx05lRi33PtcRnq5gNBXnu_JwcREy3pjNEgv9DRZ93kMbQ4dxELsZiZDjRcf33spuGVwSUK0I6jq8fdQ0lZSyybdbu2ErERNcPO-6m_NOev6v1CbM3aujJozOXO6MuDPYOerHH4VdCEsJ_gZEehvW3UsO9pY173kVdlOG57OMuF5NfRgVF2ZQ5QvyqJbbqm4u_HTawDKhRbCtExHY9QFQbvD17aFHgNf7Mx3ZW01Qe6U3KIm3hds0ihktsZUc"
            />
          </div>
          <div class="absolute -bottom-8 -right-8 glass-card p-6 rounded-lg shadow-xl hidden md:block">
            <div class="flex items-center gap-4">
              <div class="bg-primary-container w-12 h-12 rounded-full flex items-center justify-center">
                <span class="material-symbols-outlined text-secondary-fixed" data-icon="check_circle">
                  check_circle
                </span>
              </div>
              <div>
                <p class="text-sm font-bold">Viaje Colaborativo</p>
                <p class="text-xs text-on-surface-variant">Sin fines de lucro</p>
              </div>
            </div>
          </div>
        </div>
        <div class="order-1 lg:order-2 space-y-8">
          <h2 class="text-4xl font-bold font-headline tracking-tight">¿Cómo funciona?</h2>
          <p class="text-lg text-on-surface-variant">
            Trayko no es un servicio de transporte profesional. Somos una comunidad que conecta a particulares
            para optimizar sus traslados.
          </p>
          <ul class="space-y-6">
            <li class="flex items-start gap-4">
              <span class="material-symbols-outlined text-secondary mt-1" data-icon="directions_car">
                directions_car
              </span>
              <div>
                <h4 class="font-bold text-lg">Vehículo Particular</h4>
                <p class="text-on-surface-variant">
                  Utiliza tu propio auto para tus viajes habituales o viajes especiales programados.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="material-symbols-outlined text-secondary mt-1" data-icon="receipt_long">
                receipt_long
              </span>
              <div>
                <h4 class="font-bold text-lg">Costo Compartido</h4>
                <p class="text-on-surface-variant">
                  La plataforma calcula una contribución sugerida para cubrir proporcionalmente el gasto del
                  viaje.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="material-symbols-outlined text-secondary mt-1" data-icon="verified">
                verified
              </span>
              <div>
                <h4 class="font-bold text-lg">Seguridad Comunitaria</h4>
                <p class="text-on-surface-variant">
                  Perfiles verificados y sistema de valoraciones para construir una red de confianza.
                </p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonios -->
  <section id="testimonios" class="py-24 bg-primary-container text-on-primary-container overflow-hidden relative">
    <div class="absolute top-0 right-0 w-96 h-96 bg-secondary opacity-20 blur-[100px] -mr-48 -mt-48"></div>
    <div class="max-w-4xl mx-auto px-8 text-center relative z-10">
      <span class="material-symbols-outlined text-6xl mb-8 opacity-50" data-icon="format_quote">
        format_quote
      </span>
      <p class="text-3xl md:text-4xl font-bold font-headline italic leading-snug mb-10">
        "Ahora viajar entre ciudades es mucho más económico. Compartiendo mi viaje, recupero mis costos de
        bencina fácilmente."
      </p>
      <div class="flex flex-col items-center gap-4">
        <img
          alt="Carlos R."
          class="w-20 h-20 rounded-full border-4 border-on-primary-container/20 object-cover"
          data-alt="Portrait of a smiling man in casual clothes"
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuBRRGibA3fJj1lUcfOWSlO0gHpk5xnTkrmrAQNIEcAS4or0b1khAZCnoX7d-6eRR4K8xO9jAOiKsL2mu2RdLua17nMAYgF-mRo_A0sX-G2M3kJDcuUCpO78_gJFsldInOBTAwgZgT4-f012MmjTZAifPDbwjRm8tg6uRADnvk5d9Fl2bb3_KnLuP6Zoq051IkWTjzaNpMKPBvyJSC-9Qetjg3Iwl-Ox_qzvudVrdozeru8rs6zt6wqoW_PbuhyzKhlH_IJ_71rynjw"
        />
        <div>
          <h4 class="font-bold text-xl">Carlos Rodriguez</h4>
          <p class="text-on-primary-container/70">Usuario de Trayko desde 2022</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Llamado a la acción -->
  <section id="cta" class="py-24 text-center">
    <div class="max-w-7xl mx-auto px-8">
      <div
        class="bg-surface-container-high rounded-xl p-12 md:p-20 relative overflow-hidden group"
      >
        <div
          class="absolute inset-0 bg-primary opacity-0 group-hover:opacity-5 transition-opacity duration-700"
        ></div>
        <h2 class="text-4xl md:text-6xl font-bold font-headline tracking-tighter mb-8">
          ¿Listo para compartir tu ruta?
        </h2>
        <p class="text-xl text-on-surface-variant max-w-2xl mx-auto mb-12">
          Únete a miles de personas que ya están transformando la forma de viajar en Chile a través de la
          economía colaborativa.
        </p>
        <button
          class="bg-secondary-fixed text-on-secondary-container px-12 py-5 rounded-full font-bold text-xl shadow-xl hover:scale-105 active:scale-95 transition-all"
        >
          Publicar mi viaje
        </button>
      </div>
    </div>
  </section>

  <Footer />
</Layout>