---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Destinations from '../components/Destinations.astro';
import HowItWorks from '../components/HowItWorks.astro';
import DriverBenefits from '../components/DriverBenefits.astro';
import AppDownload from '../components/AppDownload.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import { PLAY_STORE_URL } from '../data/site';

const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Trayko",
  "operatingSystem": "Android",
  "applicationCategory": "TravelApplication",
  "url": PLAY_STORE_URL,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "COP"
  },
  "description": "Plataforma de carpooling y viajes compartidos entre ciudades en Colombia."
};
---

<Layout
    title="Viajes compartidos entre ciudades de Colombia | Trayko"
    description="Encuentra viajes compartidos entre ciudades de Colombia o publica cupos en tu carro. Con Trayko puedes coordinar tu ruta y compartir gastos desde la app."
    schema={appSchema}
>
    <Navbar />
    <Hero />
    <Features />
    <Destinations />
    <HowItWorks />
    <DriverBenefits />
    <AppDownload />
    <FAQ />
    <Footer />
</Layout>
